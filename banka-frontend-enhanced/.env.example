# Axios baseURL the SPA uses for API calls. Default is "/api" so dev,
# cypress, and prod all hit the same path and the request is routed by
# the vite dev proxy / production reverse-proxy. Override only when
# pointing the SPA at a different origin (e.g. preview against staging).
# VITE_API_BASE=/api

# Where the vite dev proxy forwards "/api/*" requests in `npm run dev`.
# Defaults to the local gateway. Used only by vite.config.ts.
# VITE_BACKEND_URL=http://localhost:8080

# 3-digit routing prefix of OUR bank. Used client-side to detect inter-bank
# payments and label OTC listings from other banks. Each team sets their own.
# Default is '265' (matches the account format in the spec screenshots).
# VITE_BANK_ROUTING_PREFIX=265
