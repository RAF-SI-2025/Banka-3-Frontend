{
  "name": "banka-3-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsr generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretypecheck": "tsr generate",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:soak": "cypress run --config-file cypress.soak.config.ts",
    "cypress:soak-e2e": "cypress run --config-file cypress.soak-e2e.config.ts",
    "cypress:interbank": "cypress run --config-file cypress.interbank.config.ts",
    "cypress:interbank:open": "cypress open --config-file cypress.interbank.config.ts",
    "api:gen": "openapi-typescript-codegen --input ../Banka-3-Backend/gen/openapi/banka.swagger.json --output src/lib/api/generated --client axios --useOptions"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^1.18.0",
    "@grafana/faro-web-tracing": "^1.18.0",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-vite-plugin": "^1.167.23",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "axios-mock-adapter": "^2.1.0",
    "cypress": "^15.19.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "openapi-typescript-codegen": "^0.31.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
